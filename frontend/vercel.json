{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/((?!api|_next/static|_next/image|favicon.ico).*)",
            "destination": "/index.html"
        }
    ],
    "env": {
        "VITE_API_BASE_URL": "@vite-api-base-url"
    }
}