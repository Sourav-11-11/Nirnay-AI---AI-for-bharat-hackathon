# Backend Environment Variables (Render)
# Copy to .env and update values for your environment

# Frontend domain for CORS
FRONTEND_URL=https://nirnay-ai.vercel.app

# Max file size for uploads (in bytes, default 10 MB)
MAX_DEMO_FILE_SIZE_BYTES=10485760

# Optional: Database URL (when migrating to PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:5432/nirnay_db
